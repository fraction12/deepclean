{
  "name": "@fraction12/deepclean",
  "version": "0.1.0-beta.2",
  "private": false,
  "description": "Local structure reports and agent-ready plans for fast-moving codebases.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://fraction12.github.io/deepclean/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fraction12/deepclean.git"
  },
  "bugs": {
    "url": "https://github.com/fraction12/deepclean/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/beta-onboarding.md",
    "docs/privacy-and-trust.md",
    "docs/public-readiness.md",
    "docs/release.md",
    "docs/beta-release-checklist.md",
    "docs/beta-dogfood/matrix.md",
    "docs/beta-dogfood/scorecard-template.md",
    "docs/reviewer-references.md",
    "docs/troubleshooting.md"
  ],
  "bin": {
    "deepclean": "dist/cli.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "ci": "npm run typecheck && npm test && npm run smoke:build-clean && npm run smoke:package",
    "dev": "tsx src/cli.ts",
    "release:check": "npm run ci && node scripts/prepare-release-smoke.mjs && node scripts/release-check.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "spec:validate": "node scripts/spec-validate.mjs",
    "site:build": "node scripts/build-site.mjs",
    "site:preview": "node scripts/preview-site.mjs",
    "site:render": "remotion render site/remotion/index.ts HeroTerminal site/assets/hero-terminal-loop.webm --codec=vp8 --overwrite && remotion still site/remotion/index.ts HeroTerminal site/assets/hero-terminal-poster.png --frame=165 --overwrite",
    "sync:matt-skills": "node scripts/sync-matt-pocock-skills.mjs",
    "smoke:build-clean": "node scripts/build-clean-smoke.mjs",
    "test": "vitest run --exclude \"dist/**\"",
    "smoke:package": "npm run build && node scripts/package-smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "typescript": "^6.0.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.467",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "remotion": "^4.0.467",
    "tsx": "^4.22.3",
    "vitest": "^4.1.6"
  }
}
